<Project Sdk="Microsoft.NET.Sdk">

  <!-- A stand-in for "an app with its own fullscreen", used only by the sandbox test run (tests/sandbox.ps1).
       Its fullscreen behaviour is chosen on the command line so each way real apps differ can be exercised. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>WmFixture</AssemblyName>
    <RootNamespace>WmFixture</RootNamespace>
  </PropertyGroup>

</Project>
