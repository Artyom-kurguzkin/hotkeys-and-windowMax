<Project>
  <!-- dotnet publish WindowManager -p:PublishProfile=dist  →  <repo>\dist\WindowManager.exe. The same build as repo-task-manager's dist profile: self-contained (no .NET install
       needed), single file, ReadyToRun, no symbols. The framework-dependent 1.5 MB single file was quarantined twice by Defender's machine-learning guess
       (Trojan:Win32/Bearfoos.A!ml, 2026-11-26); the task manager's self-contained build, with the same PowerShell update helper, never was. -->
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <PublishReadyToRun>true</PublishReadyToRun>
    <IncludeNativeLibrariesForSelfExtract>false</IncludeNativeLibrariesForSelfExtract>
    <DebugType>none</DebugType>
    <CopyOutputSymbolsToPublishDirectory>false</CopyOutputSymbolsToPublishDirectory>
    <PublishDir>$(MSBuildThisFileDirectory)..\..\..\dist\</PublishDir>
  </PropertyGroup>
</Project>
