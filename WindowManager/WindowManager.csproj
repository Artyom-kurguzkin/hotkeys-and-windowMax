<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <UseWindowsForms>true</UseWindowsForms> <!-- only System.Windows.Forms.Screen in the live table self-test -->
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <!-- dotnet publish WindowManager -r win-x64 -o dist  →  dist\WindowManager.exe (uses the installed .NET 10 runtime) -->
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>false</SelfContained>
    <PublishReferencesDocumentationFiles>false</PublishReferencesDocumentationFiles> <!-- the WebView2 package's 800 KB of XML docs stay out of dist -->
  </PropertyGroup>

  <!-- The injected monitor-lie DLL (built by native/build-native.ps1, committed as a binary)
       ships beside the exe; a normal build/publish needs no C compiler. -->
  <!-- Hint mode uses System.Windows.Automation (UI Automation client). Reference the WPF part of the desktop
       framework directly instead of UseWPF: UseWPF switches on WPF's XAML/markup build pass and implicit usings,
       which broke an unrelated file (BinaryWriter "not found" in one signature). No XAML here, just the assemblies. -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.WindowsDesktop.App.WPF" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4314.35" GeneratePathProperty="true" />
    <!-- The version: version.json (0.1 + git height) stamped as AssemblyInformationalVersion; AppVersion.cs reads it. Same as repo-task-manager. -->
    <PackageReference Include="Nerdbank.GitVersioning" Version="3.9.50" PrivateAssets="all" />
  </ItemGroup>

  <!-- AssemblyInformationalVersion is "0.1.12+commit" on every branch; whether this build came from main (publicReleaseRefSpec) is only known to
       Nerdbank.GitVersioning's PublicRelease property, so it is stamped as assembly metadata for AppVersion.cs. -->
  <Target Name="StampPublicRelease" DependsOnTargets="GetBuildVersion" BeforeTargets="CoreGenerateAssemblyInfo">
    <ItemGroup>
      <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
        <_Parameter1>PublicRelease</_Parameter1>
        <_Parameter2>$(PublicRelease)</_Parameter2>
      </AssemblyAttribute>
    </ItemGroup>
  </Target>

  <!-- The table editor and hotkey menu pages (WindowManager/web/**, served to WebView2 as https://wm.table/ and https://wm.hotkeys/) ship beside the exe, not inside the single file:
       the popup maps the folder, so the files must be real files. Relative paths are kept, so the output has web\editor.html, web\css\ and so on. -->
  <ItemGroup>
    <None Remove="web\**" />
    <Content Include="web\**" CopyToOutputDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
  </ItemGroup>

  <!-- WebView2's native loader is not bundled into the single-file exe; it must sit beside it. An incremental publish once deleted it from dist
       as a stale file (the popup then could not start: DllNotFoundException, 2026-11-20), so it is copied explicitly every time. -->
  <Target Name="CopyWebView2Loader" AfterTargets="Build;Publish">
    <ItemGroup>
      <WebView2Loader Include="$(PkgMicrosoft_Web_WebView2)\runtimes\win-x64\native\WebView2Loader.dll" />
    </ItemGroup>
    <Copy SourceFiles="@(WebView2Loader)" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(WebView2Loader)" DestinationFolder="$(PublishDir)" SkipUnchangedFiles="true" Condition="'$(PublishDir)' != ''" />
  </Target>

  <!-- The running manager locks its exe in dist; Windows allows renaming a running exe, so move it aside before the bundle is written
       (the running copy keeps working; the .old files are swept by UpdateHelper.Sweep and the del below once unlocked). -->
  <Target Name="MoveRunningExeAside" BeforeTargets="GenerateSingleFileBundle" Condition="'$(PublishDir)' != ''">
    <Exec Command="del /q &quot;$(PublishDir)$(AssemblyName).*.old&quot; 2&gt;nul" IgnoreExitCode="true" EchoOff="true" StandardOutputImportance="low" />
    <Move SourceFiles="$(PublishDir)$(AssemblyName).exe" DestinationFiles="$(PublishDir)$(AssemblyName).$([System.DateTime]::Now.Ticks).old"
          Condition="Exists('$(PublishDir)$(AssemblyName).exe')" ContinueOnError="true" />
  </Target>

  <!-- The hook DLL stays mapped in every GUI process until each one next pumps a message, so the copy in the
       output folder is usually still in use when we rebuild. Windows allows renaming an in-use file, so move the
       old copy aside (unique name) and copy the fresh one; stale .old files are swept once they unlock. -->
  <Target Name="CopyMonlieDll" AfterTargets="Build;Publish" Condition="Exists('native\monlie.dll')">
    <!-- del, not <Delete>: a leftover still mapped by some app is expected, not worth a warning on every build. -->
    <Exec Command="del /q &quot;$(OutDir)monlie.*.old&quot; 2&gt;nul" IgnoreExitCode="true" EchoOff="true" StandardOutputImportance="low" />
    <Move SourceFiles="$(OutDir)monlie.dll" DestinationFiles="$(OutDir)monlie.$([System.DateTime]::Now.Ticks).old"
          Condition="Exists('$(OutDir)monlie.dll')" ContinueOnError="true" />
    <Copy SourceFiles="native\monlie.dll" DestinationFolder="$(OutDir)" />
    <!-- The published copy is locked just the same (every GUI process maps the dll the running manager injected), so move it
         aside too. A new exe published next to the OLD dll lied garbage rectangles to every app (measured 2026-10-31). -->
    <Exec Command="del /q &quot;$(PublishDir)monlie.*.old&quot; 2&gt;nul" IgnoreExitCode="true" EchoOff="true" StandardOutputImportance="low" Condition="'$(PublishDir)' != ''" />
    <Move SourceFiles="$(PublishDir)monlie.dll" DestinationFiles="$(PublishDir)monlie.$([System.DateTime]::Now.Ticks).old"
          Condition="'$(PublishDir)' != '' And Exists('$(PublishDir)monlie.dll')" ContinueOnError="true" />
    <Copy SourceFiles="native\monlie.dll" DestinationFolder="$(PublishDir)" Condition="'$(PublishDir)' != ''" />
  </Target>

</Project>
